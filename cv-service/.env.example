# Which backend to run. mock needs no GPU and no clip; it is the demo fallback.
CV_BACKEND=mock            # mock | lite | gamestate

# Public Supabase bucket, so heatmap_url is a real link rather than a relative
# path. Used by the mock backend, which serves the fixture's own heatmaps.
HEATMAP_BASE=https://tifynfruqgkbuiyiljfb.supabase.co/storage/v1/object/public/heatmaps

# Heatmap publishing for the REAL backends. lite/gamestate draw a heatmap per
# track and upload it to <bucket>/<match_id>/<player_id>.svg. Without these two
# the job still succeeds and heatmap_url comes back null — the one thing it
# never does is point at the fixture's images and pass them off as this match.
SUPABASE_URL=https://tifynfruqgkbuiyiljfb.supabase.co
SUPABASE_SERVICE_KEY=
HEATMAP_BUCKET=heatmaps

# Detector weights for the "lite" backend.
YOLO_WEIGHTS=yolov8m.pt

# Image -> pitch homography, a JSON 3x3 matrix. Calibrated once per camera
# position; the Veo mount is fixed so it does not change between matches.
# Without it the lite backend cannot project and will say so.
PITCH_HOMOGRAPHY=

# Where sn-gamestate is checked out inside the image.
SN_GAMESTATE_DIR=/opt/sn-gamestate

MODAL_GPU=A10G
